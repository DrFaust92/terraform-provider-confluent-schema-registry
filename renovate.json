{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Confluent Platform versions in the acceptance test matrix",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Each matrix entry tracks one Confluent major; add new majors by hand",
      "matchDepNames": [
        "confluentinc/cp-schema-registry"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Go indirect modules are ignored by Renovate by default; update them in one grouped weekly PR (go mod tidy runs after updates)",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true,
      "groupName": "go indirect dependencies",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ],
  "forkProcessing": "enabled"
}
